# Copy to .env.local and fill in (never commit .env.local).
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: photo cleanup (Vercel Production environment variables)
SUPABASE_SECRET_KEY=
# A random value of at least 16 characters; Vercel sends this to the cron endpoint.
CRON_SECRET=
